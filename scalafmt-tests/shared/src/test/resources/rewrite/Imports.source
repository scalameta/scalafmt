<<< grouped sort ascii with nested package
rewrite.imports {
  expand = true
  sort = ascii
  groups = [
    ["a.*", "A.*"],
    ["b.*", "B.*"],
    ["c.*", "D.*"]
  ]
}
===
package a

  import a.{
    b,
    c
  }, h.{
    k, l
  }
  export d.e.{f, g}

  class A

 // comment
  import A.md.e.{f, g}

package b {
  export b.c.d.{f, g}
  import B.A.d.{f, g}

  class B
  import c.b.a.{d, f => g, g => _, _}
  export C.b.a.{d, f => g, g => _, _}

  class C
  import D.c.b.{d, f => g, g => _}
}
>>>
package a

// comment
import A.md.e.f
import A.md.e.g
import a.b
import a.c

import h.k
import h.l
export d.e.f
export d.e.g

class A

package b {
  import B.A.d.f
  import B.A.d.g
  export b.c.d.f
  export b.c.d.g

  import D.c.b.d
  import D.c.b.{f => g}
  import D.c.b.{g => _}
  import c.b.a.d
  import c.b.a.{f => g, g => _, _}

  export C.b.a.d
  export C.b.a.{f => g, g => _, _}

  class B

  class C
}
