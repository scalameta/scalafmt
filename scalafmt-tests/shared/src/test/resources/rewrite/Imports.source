rewrite.rules = [Imports]
rewrite.imports.contiguousGroups = no
runner.dialect = scala3
<<< basic with wildcard
rewrite.imports.expand = true
===
package a
import a._, h.{k, l}
>>>
package a
import a._
import h.k
import h.l
<<< basic with wildcard first
rewrite.imports.expand = true
===
package a
import a._, a.{k, l}
>>>
package a
import a._
import a.k
import a.l
<<< basic with wildcard later
rewrite.imports.expand = true
===
package a
import a.{k, l}, a._
>>>
package a
import a.k
import a.l
import a._
<<< basic expansion
rewrite.imports.expand = true
