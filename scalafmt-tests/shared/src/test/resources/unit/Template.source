
<<< extends
class A(
  b: B)
  extends C
>>>
class A(b: B) extends C
<<< extends with
class A(
  b: B)
  extends C
  with D
>>>
class A(b: B) extends C with D
<<< extends with overflows columns
class A(b: B) extends C___________ with D
>>>
class A(b: B)
    extends C___________
    with D
<<< Looong extends, no inline
class A(b: B) extends C with D with E with F with G {
  def x = 2
}
>>>
class A(b: B)
    extends C
    with D
    with E
    with F
    with G {
  def x = 2
}
<<< #5362 trailing space, empty template, then stat
class A 
class B
>>>
class A
class B
<<< #5362 trailing space, empty template, at eof
class A 
>>>
class A
<<< #5362 trailing space, empty template, comment before
class A /*c*/ 
class B
>>>
class A /*c*/
class B
<<< #5362 trailing space, template with parent
class A extends B 
class C
>>>
class A extends B
class C
<<< #5362 trailing space, template with body
class A { def f = 1 } 
class B
>>>
class A { def f = 1 }
class B
