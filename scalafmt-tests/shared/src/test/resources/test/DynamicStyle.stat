maxColumn = 100 # comment
preset = defaultWithAlign
indentOperator.topLevelOnly = false
indentOperator.exclude = ":\\+:"
align.tokens."+" = [foo]
danglingParentheses.preset = false
<<< dynamic
// scalafmt: { maxColumn = 20 }
function(aaaaaaaaaaa, bbbbbbb)
>>>
// scalafmt: { maxColumn = 20 }
function(
  aaaaaaaaaaa,
  bbbbbbb)
<<< multiline
/*
scalafmt: {
  maxColumn = 20
}
*/
function(aaaaaaaaaaa, bbbbbbb)
>>>
/*
scalafmt: {
  maxColumn = 20
}
 */
function(
  aaaaaaaaaaa,
  bbbbbbb)
<<< align.tokens.add
{
  val x = 2 + foo
  val xx = 22 + foo
}
>>>
{
  val x  = 2 +  foo
  val xx = 22 + foo
}
<<< infix types #500
type Row =
  AlertEvent :+:
  TestEvent :+:
  InteractionEvent
>>>
type Row =
  AlertEvent :+:
  TestEvent :+:
  InteractionEvent
<<< base config is preserved
{
  // scalafmt: { maxColumn = 40 }
  val x = 2 + foo
  val xx = 22 + foo
}
>>>
{
  // scalafmt: { maxColumn = 40 }
  val x  = 2 +  foo
  val xx = 22 + foo
}
<<< override align it is none originally
align.preset = none
===
object a {
  for {
    x <- "asd"
    xxxx <- "bb"
  } yield x
  // scalafmt: { align.preset = most }
  for {
    x <- "asd"
    xxxx <- "bb"
  } yield x
}
>>>
object a {
  for {
    x <- "asd"
    xxxx <- "bb"
  } yield x
  // scalafmt: { align.preset = most }
  for {
    x    <- "asd"
    xxxx <- "bb"
  } yield x
}
<<< infix maxCountPerFile, override at the top
