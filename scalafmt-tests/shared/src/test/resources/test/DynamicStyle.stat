<<< infix, override of termSite.maxCountPerFile, type and pattern
newlines.source = fold
===
object a {
  // scalafmt: { newlines.infix.termSite.maxCountPerFile = 1 }
  type T = Aaaaaaaa Map Bbbbbbbb Map
    Cccccccc
  x match {
    case aaaaaaaa :: bbbbbbbb ::
        cccccccc =>
  }
}
>>>
object a {
  // scalafmt: { newlines.infix.termSite.maxCountPerFile = 1 }
  type T = Aaaaaaaa Map Bbbbbbbb Map Cccccccc
  x match { case aaaaaaaa :: bbbbbbbb :: cccccccc => }
}
