  // scalafmt: { newlines.infix.termSite.style = some }
  type T = Aaaaaaaa Map
    Bbbbbbbb
  x match {
    case aaaaaaaa ::
        bbbbbbbb =>
  }
  val y = cccccccc ||
    dddddddd
}
>>>
