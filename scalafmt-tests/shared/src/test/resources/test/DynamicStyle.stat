<<< imports, override of newlines.source from keep to fold
newlines.source = keep
rewrite.rules = [Imports]
rewrite.imports.groups = [["a\\..*"]]
===
object a {
  // scalafmt: { newlines.source = fold }
  import a.b.{cccccccccccccccc, dddddddddddddddd, eeeeeeeeeeeeeeee, ffffffffffffffff, gggggggggggggggg, hhhhhhhh}
}
>>>
object a {
  // scalafmt: { newlines.source = fold }
  import a.b.{
    cccccccccccccccc,
    dddddddddddddddd,
    eeeeeeeeeeeeeeee,
    ffffffffffffffff,
    gggggggggggggggg,
    hhhhhhhh
  }
}
