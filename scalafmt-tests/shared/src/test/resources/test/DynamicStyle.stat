newlines.infix.termSite.maxCountPerFile = 1
===
// scalafmt: { newlines.infix.termSite.maxCountPerFile = 10 }
object a {
  val x = aaaaaaaa &&
    bbbbbbbb
  val y = cccccccc ||
    dddddddd
}
>>>
// scalafmt: { newlines.infix.termSite.maxCountPerFile = 10 }
object a {
  val x = aaaaaaaa &&
    bbbbbbbb
  val y = cccccccc ||
    dddddddd
}
